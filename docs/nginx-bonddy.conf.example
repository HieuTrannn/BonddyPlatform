# Nginx config mẫu cho bonddy.vn và api.bonddy.vn
# Trên VPS: copy vào /etc/nginx/sites-available/bonddy.vn
#   sudo cp docs/nginx-bonddy.conf.example /etc/nginx/sites-available/bonddy.vn
#   sudo ln -sf /etc/nginx/sites-available/bonddy.vn /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Sau đó chạy certbot: sudo certbot --nginx -d bonddy.vn -d www.bonddy.vn -d api.bonddy.vn

# API Backend (Bonddy .NET chạy trên port 8080)
server {
    listen 80;
    server_name api.bonddy.vn;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /hubs/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
