# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# --- PostgreSQL (postgres container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=BonddyPlatformDb

# --- JWT (min. 32 characters, e.g. `openssl rand -base64 48`) ---
JWT_SECRET=
JWT_ISSUER=BonddyPlatform
JWT_AUDIENCE=BonddyPlatform
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60

# --- SMTP (Gmail: use an App Password, not your account password) ---
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Firebase service account (raw JSON on one line, or base64 of the JSON file) ---
# base64 -w0 path/to/firebase-adminsdk.json
FIREBASE_CREDENTIALS_JSON=

# --- PayPal ---
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:3000/payment/paypal/success
PAYPAL_CANCEL_URL=http://localhost:3000/payment/paypal/cancel

# --- PayOS (VietQR) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/payos/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/payos/cancel
